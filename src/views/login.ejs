<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head><%- include('partials/head', { title: 'ورود - X-ui-ali' }) %></head>
<body>
  <div class="auth-wrap">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
    <div class="auth-card">
      <div class="auth-logo">X</div>
      <h1>ورود به X-ui-ali</h1>
      <p class="muted">پنل مدیریت کانفیگ شما</p>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <label>نام کاربری</label>
        <input name="username" required autofocus>
        <label>رمز عبور</label>
        <input name="password" type="password" required>
        <button class="btn" type="submit" style="width:100%; margin-top:20px;">ورود</button>
      </form>
    </div>
  </div>
</body>
</html>
