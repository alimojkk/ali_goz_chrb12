<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head><%- include('partials/head', { title: user.username + ' | X-ui-ali' }) %></head>
<body>
<div class="sub-page">
  <div class="sub-hero">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
    <div class="content">
      <% if (limitGB) { %>
      <div class="gauge" style="width:96px;height:96px;margin:0 auto 14px;--pct:<%= Math.min(100, Math.round((usedGB/limitGB)*100)) %>;--gauge-color: <%= (usedGB/limitGB) > 0.9 ? 'var(--red)' : 'var(--cyan)' %>;">
        <span class="avatar" style="width:100%;height:100%;margin:0;font-size:28px; box-shadow:none;"><%= user.username.charAt(0).toUpperCase() %></span>
      </div>
      <% } else { %>
      <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <% } %>
      <h1><%= user.username %></h1>
      <span class="badge <%= active ? 'on' : 'off' %>"><%= active ? '● فعال' : '● غیرفعال' %></span>

      <p class="muted" style="margin-top:14px;">
        مصرف شده: <bdi dir="ltr"><b style="color:var(--text)"><%= usedGB %> GB</b>
        <%= limitGB ? ' از ' + limitGB + ' GB' : '' %></bdi><%= limitGB ? '' : ' (نامحدود)' %>
      </p>
      <% if (limitGB) { %>
      <div class="progress" style="max-width:320px;margin:0 auto;">
        <div style="width: <%= Math.min(100, (usedGB/limitGB)*100) %>%; <%= (usedGB/limitGB) > 0.9 ? 'background:var(--red);' : '' %>"></div>
      </div>
      <% } %>

      <div class="applink-row">
        <a class="applink" href="v2rayng://install-sub?url=<%= encodeURIComponent(subUrl) %>">📲 v2rayNG</a>
        <a class="applink" href="sn://subscription?url=<%= encodeURIComponent(subUrl) %>&name=<%= encodeURIComponent(user.username) %>">📱 NekoBox</a>
        <a class="applink" href="hiddify://import/<%= encodeURIComponent(subUrl) %>">🟢 Hiddify</a>
        <a class="applink" href="streisand://import/<%= encodeURIComponent(subUrl) %>">🍏 Streisand</a>
      </div>
      <p class="muted" style="font-size:11px; margin-top:8px;">دکمه‌های بالا در صورت نصب همان اپ روی گوشی، مستقیماً ساب را وارد می‌کنند؛ در غیر این صورت لینک را دستی کپی کنید.</p>
    </div>
  </div>

  <div class="card">
    <div class="flex-between">
      <h2 class="mb0">🔗 لینک اشتراک (Subscription)</h2>
    </div>
    <p class="muted">این لینک را در کلاینت به‌عنوان Subscription وارد کنید تا همیشه به‌روز بماند.</p>
    <div class="link-row">
      <code id="subUrl"><%= subUrl %></code>
      <button class="btn small secondary" onclick="copyText('subUrl')">کپی</button>
    </div>
    <div style="text-align:center; margin-top: 16px;">
      <img src="<%= subQr %>" alt="QR subscription" style="border-radius:14px; background:#fff; padding:12px; max-width:200px;">
    </div>
  </div>

  <h2 style="margin: 26px 4px 14px;">📦 کانفیگ‌های تکی</h2>
  <div class="grid cols-2">
    <% links.forEach(function(l, i) { %>
    <div class="qr-card proto-<%= l.key %>">
      <img src="<%= l.qr %>" alt="QR <%= l.protocol %>">
      <div class="proto-tag"><span class="proto-dot"></span><%= l.protocol %></div>
      <div class="link-row">
        <code id="l-<%= i %>" style="font-size:10px;"><%= l.link %></code>
      </div>
      <button class="btn small secondary" onclick="copyText('l-<%= i %>')">کپی لینک</button>
    </div>
    <% }) %>
  </div>

  <p class="footer-note">⚠️ این صفحه را فقط با خود کاربر به اشتراک بگذارید — هرکس این لینک را داشته باشد می‌تواند از سهمیه شما استفاده کند.<br>ساخته‌شده با X-ui-ali</p>
</div>
<%- include('partials/toast') %>
<script>
function copyText(id) {
  const text = document.getElementById(id).innerText;
  navigator.clipboard.writeText(text).then(() => showToast('کپی شد ✅'));
}
</script>
</body>
</html>
